#!/bin/sh
# This Source Code Form is subject to the terms of the Mozilla Public
# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at https://mozilla.org/MPL/2.0/.
#
# mind-relay - carries a message from Project Mind into the Claude Code session that is working a task
# (DESIGN.md "Build" BT16). Started, detached, by mind-checkin-hook.sh on the first tool call of a session that has
# a binding; nobody runs it by hand. POSIX sh, curl, nc: no Node, no jq.
#
#   mind-relay KEY CLAUDE_PID        KEY = cksum of the session's socket path; one relay per socket, not per session
#
# What it does: long-polls GET /api/v1/inbox for the tasks bound by every session id on this socket, waits 10 s for a
# second message, writes ONE user turn into the session's own socket, then acks. It uses no tokens while it waits.
#
# Security rules, all load-bearing:
#  - A message is text from another person or session. The server hands it over already quoted (one line, quotes
#    escaped); this script checks that, puts it under a FIXED preamble that says it is data, and never runs or
#    evals any part of it. It is only ever JSON-escaped and written to the socket.
#  - The socket path and token come from Claude's own environment, are checked against a strict alphabet, and the
#    token never appears in a process argument (curl reads it from stdin; nc reads the auth line from stdin).
#  - It posts only on Claude Code 2.1.x from TESTED_FLOOR up, and never on a KNOWN_BAD one. On any other it keeps polling (so
#    the sender's row can say "relay paused: untested Claude Code X"), posts nothing and acks nothing. A version at or above the
#    floor that no one has proven yet may post, and is called "unproven": a socket write gets no reply, so the proof is a round trip.
#    After each post the relay writes relays/KEY.posted-at ("epoch version"); the next tool call of that session (the PostToolUse
#    hook) inside 10 minutes proves the version (it is added to ok-versions) and clears the file. Two unproven posts in a row that no
#    tool call follows pause that version ("did not answer two wakes") until a newer version or a re-run of `mind-checkin install`.
#  - It exits when Claude's pid is gone, the socket is gone or refuses a probe four times in a row (5 s apart), or the sign-in is
#    removed. The Stop hook of mind-checkin-hook.sh starts it again while the session idles. With no
#    socket in the environment (cloud, -p, headless) it exits at once.
#  - A notice (BT19-BT21) is server-written text too, quoted the same way. The relay ACKS it the moment it receives it and keeps it in a
#    local `pending` file (mode 600), so a notice it holds back never comes back on a poll. It posts from that file: a batch of
#    only plain notices waits up to 3 minutes for company; an urgent notice or any message posts at once and carries the waiting
#    notices with it. Notice-only turns are capped at 6 an hour (2 of them kept for urgent ones) and 40 a day. A line whose ref
#    is in the `own` file of a session on this socket is the session's own report and is dropped, and acked.
#  - Job results (BT23): the hook writes `J <epoch> <jobId>...` group lines to sessions/<id>.jobs; the relay appends `D <jobId>` when an id has
#    been reported (or retired, or dropped past 20 open ids). It never rewrites that file. The poll names the open ids (and marks them `waiting`
#    only while the session is idle). An ended job's result is kept in relays/KEY.jended; ONE turn is posted when every job of a group has ended,
#    at once when one FAILs, is BLOCKED or gives up, never for a cancel alone. Job turns have their own cap (12 an hour, 60 a day); a line older
#    than 7 days is retired with one turn. Every text field comes quoted from the server, as for a message.
#  - Watches (BT27-BT37): `mind-checkin watch` writes `W <epoch> <watchId>` lines to relays/KEY.watches (PP20 a), the hook still to sessions/<id>.watches, which the relay keeps reading (migration); the relay appends `D <watchId>`
#    when an id was posted or the server called it denied. The poll names the open ids (at most 20, never one it holds as fired). A fired answer
#    (`K id fired "quoted firedText"`) is kept in relays/KEY.wended and posted in ONE turn with whatever else that poll brings: a job turn, a
#    message turn, or a turn of its own. It shares the job-turn cap (12 an hour, 60 a day), and past it the answer is held, never re-sent. No server ack.
#  - The transport is the one function post_line, for a later PowerShell variant (Windows has no nc in Git Bash).
umask 077
LC_ALL=C
export LC_ALL
dir="${MIND_CHECKIN_DIR:-$HOME/.config/mind}"
case $0 in */*) here=$(cd "${0%/*}" 2>/dev/null && pwd) ;; *) here=$(pwd) ;; esac
TAB=$(printf '\t')
# The lowest Claude Code version this was tried against; the same major.minor (2.1.x) from there up may post. A higher one is
# "unproven" until a round trip proves it (see above). KNOWN_BAD: versions that must never post, space separated.
TESTED_FLOOR=2.1.317
KNOWN_BAD=""
# Versions posted into a real session by hand before the round-trip proof existed; ok-versions (written by the hook) adds to them.
PROVEN="2.1.317 2.1.318 2.1.319"
SCOPE=mind:relay
# Timings, in seconds. The defaults are the contract; only the tests change them.
num() { case $1 in ''|*[!0-9]*) printf '%s' "$2" ;; *) printf '%s' "$1" ;; esac; }
POLL_WAIT=$(num "${MIND_RELAY_WAIT:-}" 50)
COALESCE=$(num "${MIND_RELAY_COALESCE:-}" 10)
NOTICE_HOLD=$(num "${MIND_RELAY_NOTICE_HOLD:-}" 180)
# Notice-only turns: per hour (of which plain ones may use all but 2) and per day. The contract, not a knob.
CAP_HOUR=6
CAP_PLAIN=4
CAP_DAY=40
NOTICE_TTL=86400
FOLLOWS_MAX=10
PROBE_EVERY=$(num "${MIND_RELAY_PROBE:-}" 300)
PROBE_RETRY=$(num "${MIND_RELAY_PROBE_RETRY:-}" 5)
WAKE_WAIT=$(num "${MIND_RELAY_WAKE_WAIT:-}" 600)
BACKOFF_MIN=$(num "${MIND_RELAY_BACKOFF_MIN:-}" 5)
BACKOFF_MAX=$(num "${MIND_RELAY_BACKOFF_MAX:-}" 300)
JOB_RETIRE=$(num "${MIND_RELAY_JOB_RETIRE:-}" 604800)
TICK=$(num "${MIND_RELAY_TICK:-}" 5)
[ "$TICK" -ge 1 ] || TICK=1

key=${1:-}
cpid=${2:-}
case $key in ''|*[!0-9]*) exit 0 ;; esac
case $cpid in ''|*[!0-9]*) exit 0 ;; esac

# ---------------------------------------------------------------- the environment Claude gave us
sock=${CLAUDE_CODE_MESSAGING_SOCKET:-}
tok=${CLAUDE_CODE_MESSAGING_TOKEN:-}
unset CLAUDE_CODE_MESSAGING_TOKEN
# No socket (cloud, -p, headless): nothing to write to.
[ -n "$sock" ] && [ -n "$tok" ] || exit 0
case $sock in /*) ;; *) exit 0 ;; esac
case $sock in *[!A-Za-z0-9_./-]*) exit 0 ;; esac
case $tok in *[!A-Za-z0-9_.=+/-]*) exit 0 ;; esac
[ -S "$sock" ] || exit 0
for t in nc curl awk sed tr date sleep kill mkdir mv; do command -v "$t" >/dev/null 2>&1 || exit 0; done

mkdir -p "$dir/relays" || exit 0
pidf="$dir/relays/$key.pid"
statf="$dir/relays/$key.status"
sidsf="$dir/relays/$key.sids"
deliveredf="$dir/relays/$key.delivered"
pendingf="$dir/relays/$key.pending"
postsf="$dir/relays/$key.posts"
postedf="$dir/relays/$key.posted-at"
hookatf="$dir/relays/$key.hook-at"
jendedf="$dir/relays/$key.jended"
wendedf="$dir/relays/$key.wended"
jpostsf="$dir/relays/$key.jposts"
polledf="$dir/relays/$key.polled-at"
missf="$dir/relays/$key.misses"
okvf="$dir/ok-versions"
leftf="$dir/relays/$key.left"
lockd="$dir/relays/$key.lock"
genf="$dir/relays/$key.gen"
kwatchesf="$dir/relays/$key.watches"
T=
cleanup() {
  _p=
  [ -f "$pidf" ] && read -r _p < "$pidf"
  if [ "$_p" = "$$" ]; then rm -f "$pidf" "$statf" "$leftf" "$polledf" "$genf"; fi
  rmdir "$lockd" 2>/dev/null
  [ -z "$T" ] || rm -rf "$T"
}
trap cleanup EXIT
trap 'exit 0' HUP INT TERM

# One relay per socket: a live one already running wins.
if [ -f "$pidf" ]; then
  read -r _other < "$pidf"
  case $_other in ''|*[!0-9]*) ;; *) if [ "$_other" != "$$" ] && kill -0 "$_other" 2>/dev/null; then trap - EXIT; rmdir "$lockd" 2>/dev/null; exit 0; fi ;; esac
fi
# Which install this relay is (PP20 b): the first line of bin/.plugin-gen ("<gen> <cksum> <size>", or `connect-line`) names the installed
# scripts. A running sh never reloads its script, so the relay remembers the line it started under, writes it to relays/KEY.gen (the hook
# replaces a relay whose gen is missing or old) and execs the installed mind-relay when the line changes (maybe_reload, top of the loop).
# The gen goes down BEFORE the pid, so a hook that finds a live pid always finds a gen too. No .plugin-gen (a checkout, a test): no gen.
installed_gen() { _g=; [ -f "$dir/bin/.plugin-gen" ] && read -r _g < "$dir/bin/.plugin-gen"; printf '%s' "$_g"; }
gen0=$(installed_gen)
if [ -n "$gen0" ]; then printf '%s\n' "$gen0" > "$genf.tmp.$$" && mv -f "$genf.tmp.$$" "$genf"; else rm -f "$genf"; fi
printf '%s\n' "$$" > "$pidf.tmp.$$" && mv -f "$pidf.tmp.$$" "$pidf" || exit 0
rm -f "$dir/relays/$key.replacing" # the hook's note that an old relay was told to stop: this is its replacement
rmdir "$lockd" 2>/dev/null
T=$(mktemp -d "${TMPDIR:-/tmp}/mind-relay.XXXXXX") || exit 0
: > "$T/skip"
: > "$T/fo"
: >> "$pendingf"
: >> "$postsf"
: >> "$jendedf"
: >> "$wendedf"
: >> "$jpostsf"

wr() { printf '%s\n' "$2" > "$1.tmp.$$" && mv -f "$1.tmp.$$" "$1"; }
rd() { cat "$1" 2>/dev/null; }

# ---------------------------------------------------------------- reload (PP20 b)
RELOAD_EVERY=$(num "${MIND_RELAY_RELOAD:-}" 60)
last_reload_check=$(date +%s)
bad_gen=
# Called between polls, so nothing is in flight: held notices, results and watch ids all live in files the new process reads again.
# The token was unset above (it must not stay in the environment of the processes this relay starts), so it is passed on the exec line.
maybe_reload() {
  _rn=$(date +%s)
  [ $((_rn - last_reload_check)) -ge "$RELOAD_EVERY" ] || return 0
  last_reload_check=$_rn
  _rg=$(installed_gen)
  [ "$_rg" != "$gen0" ] || return 0
  [ "$_rg" != "$bad_gen" ] || return 0
  _ri="$dir/bin/mind-relay"
  if [ ! -f "$_ri" ] || ! sh -n "$_ri" 2>/dev/null; then
    # A broken file is never exec'd (the relay would die and a session would lose its wakes); say so, once per gen, and keep running.
    bad_gen=$_rg
    printf '%s %s not exec: %s is missing or does not parse\n' "$_rn" "$_rg" "$_ri" > "$dir/relays/$key.reload-err"
    return 0
  fi
  rm -rf "$T"; T=
  CLAUDE_CODE_MESSAGING_TOKEN=$tok exec sh "$_ri" "$key" "$cpid"
}

# ---------------------------------------------------------------- version gate (fail safe)
claude_version() {
  _p=${CLAUDE_CODE_EXECPATH:-}
  # Claude Code sets CLAUDE_CODE_EXECPATH for its Bash tool but NOT for hooks (seen on 2.1.318), and this relay is started by a
  # hook. So ask the running session's own pid which executable it is: never the `claude` on PATH, which an auto-update may
  # already point at a different version than the one running.
  if [ -z "$_p" ]; then
    if [ -r "/proc/$cpid/exe" ]; then
      _p=$(readlink "/proc/$cpid/exe" 2>/dev/null)
    else
      _l=$(command -v lsof 2>/dev/null) || _l=
      [ -n "$_l" ] || { [ -x /usr/sbin/lsof ] && _l=/usr/sbin/lsof; }
      [ -z "$_l" ] || _p=$("$_l" -a -p "$cpid" -d txt -Fn 2>/dev/null | sed -n 's/^n//p' | head -n 1)
    fi
  fi
  _v=
  case $_p in
    /*)
      _b=${_p##*/}
      case $_b in ''|*[!0-9.]*|.*|*..*|*.) ;; *) _v=$_b ;; esac
      if [ -z "$_v" ] && [ -x "$_p" ]; then
        _v=$("$_p" --version 2>/dev/null </dev/null | head -n 1 | sed -n -E 's/^([0-9]+(\.[0-9]+)*)( .*)?$/\1/p')
      fi
      ;;
  esac
  printf '%s' "${_v:-unknown}"
}
version=$(claude_version)
paused=; pwhy=; unproven=; last_status=
# Sets paused (the version, or empty), pwhy (untested or nowake) and unproven (the version, or empty) from the version and the two files
# the hook and this relay keep, and writes the status file when it changed. Run at the top of every loop.
gate() {
  paused=; pwhy=; unproven=
  _vv=1
  case $version in ''|*[!0-9.]*|.*|*..*|*.) _vv= ;; esac
  _t=${version#*.}; _t=${_t#*.}
  case $_t in ''|*.*) _vv= ;; esac
  if [ -n "$_vv" ]; then
    { [ "${version%.*}" = "${TESTED_FLOOR%.*}" ] && [ "${version##*.}" -ge "${TESTED_FLOOR##*.}" ]; } || _vv=
  fi
  case " $KNOWN_BAD " in *" $version "*) _vv= ;; esac
  if [ -z "$_vv" ]; then
    paused=$version; pwhy=untested
  elif case " $PROVEN " in *" $version "*) false ;; esac && ! grep -Fqx -- "$version" "$okvf" 2>/dev/null; then
    unproven=$version
    _mv=; _mn=0
    [ -f "$missf" ] && read -r _mv _mn < "$missf"
    case $_mn in ''|*[!0-9]*) _mn=0 ;; esac
    if [ "$_mv" = "$version" ] && [ "$_mn" -ge 2 ]; then paused=$version; pwhy=nowake; fi
  else
    rm -f "$missf"
  fi
  if [ -n "$paused" ]; then
    _st="paused $paused"; [ "$pwhy" != nowake ] || _st="$_st nowake"
  elif [ -n "$unproven" ]; then
    _st="unproven $unproven"
  else
    _st=running
  fi
  [ "$_st" = "$last_status" ] || { wr "$statf" "$_st"; last_status=$_st; }
}
gate

# ---------------------------------------------------------------- identity of this relay
mid=$(rd "$dir/machine-id" | head -n 1)
case $mid in ''|*[!0-9a-f]*) mid= ;; esac
[ ${#mid} -eq 16 ] || {
  mid=$(od -An -N8 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')
  case $mid in ''|*[!0-9a-f]*) exit 0 ;; esac
  wr "$dir/machine-id" "$mid"
}
relay_id="m$mid-$key"

# ---------------------------------------------------------------- liveness
alive() { kill -0 "$cpid" 2>/dev/null && [ -S "$sock" ]; }
# Sleep $1 seconds in ticks, leaving early (status 1) when the session or its socket is gone.
nap() {
  _n=$1
  while [ "$_n" -gt 0 ]; do
    _s=$TICK; [ "$_n" -lt "$_s" ] && _s=$_n
    sleep "$_s"
    _n=$((_n - _s))
    alive || return 1
  done
  return 0
}
# The transport: one JSON text (already escaped) as a user turn, after the auth line. No reply line exists.
post_line() {
  {
    printf '{"type":"auth","token":"%s"}\n' "$tok"
    printf '{"type":"user","message":{"role":"user","content":"%s"}}\n' "$1"
  } | nc -U -w 5 "$sock" >/dev/null 2>&1 && mark_posted
}
probe() { printf '{"type":"auth","token":"%s"}\n' "$tok" | nc -U -w 2 "$sock" >/dev/null 2>&1; }
# A refused probe is tried again 3 times, 5 s apart, before the relay gives up (a busy Claude Code may miss one).
probe_alive() {
  _pi=0
  while :; do
    probe && return 0
    _pi=$((_pi + 1))
    [ "$_pi" -le 3 ] || return 1
    nap "$PROBE_RETRY" || return 1
  done
}
# After each successful post: "epoch version", for the hook to prove the version with (the hook clears the file).
mark_posted() {
  # "epoch version idle window". idle = 1 when the session was idle at this moment: its Stop hook (idle-at) ran after its last tool call
  # (busy-at). The window is the one source of truth for the hook too.
  _ia=0; _ba=0
  read -r _ia < "$dir/relays/$key.idle-at" 2>/dev/null
  read -r _ba < "$dir/relays/$key.busy-at" 2>/dev/null
  case $_ia in ''|*[!0-9]*) _ia=0 ;; esac
  case $_ba in ''|*[!0-9]*) _ba=0 ;; esac
  _idle=0; [ "$_ia" -gt 0 ] && [ "$_ia" -ge "$_ba" ] && _idle=1
  printf '%s %s %s %s\n' "$(date +%s)" "$version" "$_idle" "$WAKE_WAIT" > "$postedf.tmp.$$" && mv -f "$postedf.tmp.$$" "$postedf"
}
# A post into an IDLE session that no hook event (tool call or Stop) followed within the window is a missed wake; gate() pauses an unproven
# version at two in a row. A post into a busy session is neither proof nor miss and is just cleared, like one whose version is proven by now.
settle_wakes() {
  [ -f "$postedf" ] || return 0
  _pe=; _pv=; _pi=; _pw=
  read -r _pe _pv _pi _pw < "$postedf" 2>/dev/null
  case $_pe in ''|*[!0-9]*) rm -f "$postedf"; return 0 ;; esac
  case $_pw in ''|*[!0-9]*) _pw=$WAKE_WAIT ;; esac
  [ $(($(date +%s) - _pe)) -ge "$_pw" ] || return 0
  rm -f "$postedf"
  [ -n "$unproven" ] && [ "$_pi" = 1 ] && [ "$_pv" = "$version" ] || return 0
  _mv=; _mn=0
  [ -f "$missf" ] && read -r _mv _mn < "$missf"
  case $_mn in ''|*[!0-9]*) _mn=0 ;; esac
  [ "$_mv" = "$version" ] || _mn=0
  wr "$missf" "$version $((_mn + 1))"
}

# ---------------------------------------------------------------- sign-in files
origin_ok() {
  case $1 in
    https://?*|http://127.0.0.1|http://127.0.0.1:*|http://localhost|http://localhost:*) ;;
    *) return 1 ;;
  esac
  case ${1#*://} in */*|*[!A-Za-z0-9.:_-]*) return 1 ;; esac
  return 0
}
# Sets OD (the origin's folder) and ORIGIN to the first signed-in origin that holds a RELAY token. Logging out, or logging in again
# with a check-in token only, removes it, and the relay then ends.
find_origin() {
  OD=; ORIGIN=
  for _d in "$dir"/origins/*/; do
    [ -s "$_d/refresh" ] || continue
    [ "$(rd "$_d/scope" | head -n 1)" = "$SCOPE" ] || continue
    _o=$(rd "$_d/origin" | head -n 1)
    origin_ok "$_o" || continue
    OD=${_d%/}; ORIGIN=$_o
    return 0
  done
  return 1
}

# Live bindings of one session: "server<TAB>task". Same rule as mind-checkin: 4 hours from the last report, a later D removes it.
live_bindings() {
  [ -f "$dir/sessions/$1.bind" ] || return 0
  awk -F"$TAB" -v now="$(date +%s)" '
    { k = $2 "\t" $3
      if ($4 == "B" && now - $1 < 14400) { if (!(k in live)) order[++n] = k; live[k] = 1 }
      else delete live[k] }
    END { for (i = 1; i <= n; i++) if (order[i] in live) { print order[i]; delete live[order[i]] } }' "$dir/sessions/$1.bind"
}

# Live follows of one session: "expiry-epoch-of-the-record<TAB>server<TAB>task". A line is <epoch> TAB <server> TAB <task> TAB <expiry>,
# expiry 0 = unfollowed; the newest line for a (server, task) wins, and a follow is live while its expiry is in the future.
live_follows() {
  [ -f "$dir/sessions/$1.follow" ] || return 0
  awk -F"$TAB" -v now="$(date +%s)" '
    $4 ~ /^[0-9]+$/ { k = $2 "\t" $3; if ($4 + 0 > now) live[k] = $1; else delete live[k] }
    END { for (k in live) print live[k] "\t" k }' "$dir/sessions/$1.follow"
}

# Prints the task ids to poll, comma separated, at most 20: the BOUND tasks first (union over every session id on this socket, since a
# /clear gives a new id on the same socket), then at most 10 followed tasks, newest follow first (BT18). Only servers this origin names, and
# not tasks the server said are denied or gone in the last 10 minutes. $T/fo lists every follow-only task ("task server session") so a
# denied one can be retired; $leftf says how many followed tasks did not fit.
collect_tasks() {
  _out=; _n=0; _left=0; _nf=0
  _now=$(date +%s)
  : > "$T/fo"
  [ -f "$sidsf" ] || return 0
  while read -r _sid; do
    case $_sid in ''|*[!A-Za-z0-9_-]*) continue ;; esac
    live_bindings "$_sid" > "$T/live"
    while IFS=$TAB read -r _server _task; do
      case $_task in ''|*[!A-Za-z0-9_-]*) continue ;; esac
      grep -qx -- "$_server" "$OD/servers" 2>/dev/null || continue
      case ",$_out," in *",$_task,"*) continue ;; esac
      if awk -v t="$_task" -v now="$_now" '$1 == t && now - $2 < 600 { f = 1 } END { exit !f }' "$T/skip"; then continue; fi
      [ "$_n" -lt 20 ] || continue
      _out=${_out:+$_out,}$_task
      _n=$((_n + 1))
    done < "$T/live"
  done < "$sidsf"
  _bound=$_out
  : > "$T/follows"
  while read -r _sid; do
    case $_sid in ''|*[!A-Za-z0-9_-]*) continue ;; esac
    live_follows "$_sid" | while IFS=$TAB read -r _e _server _task; do printf '%s\t%s\t%s\t%s\n' "$_e" "$_server" "$_task" "$_sid"; done >> "$T/follows"
  done < "$sidsf"
  sort -rn "$T/follows" > "$T/follows.sorted" 2>/dev/null
  while IFS=$TAB read -r _e _server _task _sid; do
    case $_task in ''|*[!A-Za-z0-9_-]*) continue ;; esac
    case $_e in ''|*[!0-9]*) continue ;; esac
    grep -qx -- "$_server" "$OD/servers" 2>/dev/null || continue
    # A task that is also bound is held by its binding: a denied answer then must not touch the follow.
    case ",$_bound," in *",$_task,"*) continue ;; esac
    printf '%s %s %s\n' "$_task" "$_server" "$_sid" >> "$T/fo"
    case ",$_out," in *",$_task,"*) continue ;; esac
    if awk -v t="$_task" -v now="$_now" '$1 == t && now - $2 < 600 { f = 1 } END { exit !f }' "$T/skip"; then continue; fi
    if [ "$_nf" -ge "$FOLLOWS_MAX" ] || [ "$_n" -ge 20 ]; then _left=$((_left + 1)); continue; fi
    _out=${_out:+$_out,}$_task
    _n=$((_n + 1))
    _nf=$((_nf + 1))
  done < "$T/follows.sorted"
  wr "$leftf" "$_left"
  printf '%s' "$_out"
}

# ---------------------------------------------------------------- http
CODE=000
PJOBS=
PPR=
PWAIT=
PWATCH=
RETRY=0
TOKEN=
# get_poll WAIT TASKS -> body in $T/body, headers in $T/hdr. The poll has its own curl timeout, longer than WAIT and shorter than nginx's 60 s.
get_poll() {
  _url="$ORIGIN/api/v1/inbox?relay=$relay_id&tasks=$2&wait=$1&format=lines&notices=1"
  # BT23: the open job ids, and of those the ones to count as waited-on (set by the loop; empty for the short second poll).
  [ -z "$PJOBS" ] || _url="$_url&jobs=$PJOBS"
  [ -z "$PWAIT" ] || _url="$_url&waiting=$PWAIT"
  # JO6: the ids of done jobs whose PR is still being followed.
  [ -z "$PPR" ] || _url="$_url&prjobs=$PPR"
  # BT31: the open watch ids (the wire shape of a watch poll lives here and in parse_body's K case).
  [ -z "$PWATCH" ] || _url="$_url&watches=$PWATCH"
  if [ -n "$paused" ]; then
    _url="$_url&paused=$paused"; [ "$pwhy" != nowake ] || _url="$_url&why=nowake"
  elif [ -n "$unproven" ]; then
    _url="$_url&unproven=$unproven"
  fi
  # PP21: the install this relay runs under (the first field of its .plugin-gen line, only when it is a gen number or connect-line) and
  # whether this session's hooks ran in the last 10 minutes (relays/KEY.hook-at, read the way doctor reads a stamp). No subprocess but date.
  _g=${gen0%% *}
  case $_g in connect-line) _url="$_url&gen=$_g" ;; ''|*[!0-9]*) ;; *) [ ${#_g} -gt 12 ] || _url="$_url&gen=$_g" ;; esac
  _hk=0; _hv=0; [ ! -f "$hookatf" ] || read -r _hv < "$hookatf" || :
  case $_hv in ''|*[!0-9]*) _hv=0 ;; esac
  [ "$_hv" -gt 0 ] && [ $(( $(date +%s) - _hv )) -le 600 ] && _hk=1
  _url="$_url&hooks=$_hk"
  _m=$(($1 + 5)); [ "$_m" -le 58 ] || _m=58
  : > "$T/body"; : > "$T/hdr"
  CODE=$({
    printf 'url = "%s"\nheader = "Accept: text/plain"\n' "$_url"
    printf 'header = "Authorization: Bearer %s"\n' "$TOKEN"
  } | curl -sS -m "$_m" -K - -o "$T/body" -D "$T/hdr" -w '%{http_code}' 2>/dev/null) || CODE=000
  [ -n "$CODE" ] || CODE=000
}
# post_ack IDS (space separated, each already checked)
post_ack() {
  _ids=
  for _i in $1; do _ids="${_ids:+$_ids,}\\\"$_i\\\""; done
  : > "$T/body"; : > "$T/hdr"
  CODE=$({
    printf 'url = "%s/api/v1/inbox/ack"\nrequest = "POST"\nheader = "Content-Type: application/json"\n' "$ORIGIN"
    printf 'header = "Authorization: Bearer %s"\n' "$TOKEN"
    # The escaped quotes go in as an argument, never in the format: dash's printf (Linux /bin/sh) keeps `\"`
    # in a format literally, where bash turns it into `"`, and the JSON body broke on Linux only.
    _q='\"'
    printf 'data = "%s"\n' "{${_q}relay${_q}:${_q}${relay_id}${_q},${_q}ids${_q}:[${_ids}]}"
  } | curl -sS -m 15 -K - -o "$T/body" -D "$T/hdr" -w '%{http_code}' 2>/dev/null) || CODE=000
  [ -n "$CODE" ] || CODE=000
}
retry_after() { sed -n -E 's/^[Rr][Ee][Tt][Rr][Yy]-[Aa][Ff][Tt][Ee][Rr]: *([0-9]+).*/\1/p' "$T/hdr" | head -n 1; }

# ---------------------------------------------------------------- backoff
bo=0
jitter() { awk -v max="$1" -v s="$$$(date +%s)" 'BEGIN { srand(s); print int(rand() * (max + 1)) }' 2>/dev/null || printf 0; }
# Any error: wait 5 s, then 10, 20 ... up to 5 minutes, plus jitter, and never less than Retry-After says. Returns 1 when the relay should stop.
fail() {
  if [ "$bo" -eq 0 ]; then bo=$BACKOFF_MIN; else bo=$((bo * 2)); fi
  [ "$bo" -le "$BACKOFF_MAX" ] || bo=$BACKOFF_MAX
  _ra=$(num "$(retry_after)" 0)
  [ "$_ra" -le 3600 ] || _ra=3600
  _w=$bo
  [ "$_ra" -le "$_w" ] || _w=$_ra
  _j=$(num "$(jitter $((_w / 4)))" 0)
  _t=$((_w + _j))
  # At the cap the jitter is taken off, not added, so a message is never more than 5 minutes late (unless Retry-After says so).
  if [ "$_t" -gt "$BACKOFF_MAX" ] && [ "$_ra" -le "$BACKOFF_MAX" ]; then _t=$((BACKOFF_MAX - _j)); fi
  nap "$_t"
}

# ---------------------------------------------------------------- reading the answer
# Parses $T/body into $T/msgs ("id TAB from TAB title TAB body") and notes denied/gone tasks in $T/skip. A line that is not exactly
# the shape the server writes is ignored; every text field must be a quoted string, with controls dropped.
parse_body() {
  : > "$T/msgs"
  _now=$(date +%s)
  : > "$T/notices"
  : > "$T/jres"
  : > "$T/jden"
  : > "$T/jred"
  : > "$T/jset"
  : > "$T/wres"
  : > "$T/wden"
  while IFS=$TAB read -r _k _a _b _c _d _e _f _g _h; do
    _a=$(printf '%s' "$_a" | tr -d '\r')
    case $_k in
      J)
        # BT23: J id denied|open, or J id ended kind outcome label url reason spend (no field empty; the three text fields quoted).
        case $_a in ''|*[!A-Za-z0-9_-]*) continue ;; esac
        [ ${#_a} -le 64 ] || continue
        case $_b in
          denied) printf '%s\n' "$_a" >> "$T/jden" ;;
          pr-settled) printf '%s\n' "$_a" >> "$T/jset" ;;
          pr-red)
            # JO6: J id pr-red PR# prUrl "checks" nudgeAt. Only the PR number, the check names and the nudgeAt are used; all else is ignored.
            _f=$(printf '%s' "$_f" | tr -d '\r')
            case $_c in ''|*[!0-9]*) continue ;; esac
            case $_f in ''|*[!0-9A-Za-z:.+-]*) continue ;; esac # nudgeAt is an ISO time
            [ ${#_c} -le 9 ] && [ ${#_f} -le 40 ] || continue
            case $_e in \"*\") ;; *) continue ;; esac
            _e=${_e#\"}; _e=${_e%\"}
            _e=$(printf '%s' "$_e" | tr -d '\000-\037\177`')
            _e=$(printf '%s' "$_e" | cut -c1-600)
            printf '%s\t%s\t%s\t%s\n' "$_a" "$_c" "$_e" "$_f" >> "$T/jred"
            ;;
          ended)
            _h=$(printf '%s' "$_h" | tr -d '\r')
            _ok=1
            case $_c in feature|test|experiment) ;; *) _ok=0 ;; esac
            case $_d in done|failed|cancelled|PASS|FAIL|BLOCKED|BETTER|WORSE|SAME|INCONCLUSIVE|MIXED) ;; *) _ok=0 ;; esac
            for _x in "$_e" "$_f" "$_g"; do
              case $_x in -) ;; \"*\") [ ${#_x} -ge 2 ] && [ ${#_x} -le 2200 ] || _ok=0 ;; *) _ok=0 ;; esac
            done
            case $_h in -) ;; [0-9]*) case $_h in *[!0-9.]*) _ok=0 ;; esac ;; *) _ok=0 ;; esac
            if [ "$_ok" != 1 ]; then
              # A record the relay cannot read must not loop (the server would hand it back at once) or lose the result: it is still
              # the job's end. Say so in plain words, with an outcome only if that is a bare word, and let the group close the id.
              case $_d in ''|*[!A-Za-z]*) _d=unknown ;; esac
              [ ${#_d} -le 16 ] || _d=unknown
              printf '%s\tplain\t%s\t-\t-\t-\t-\n' "$_a" "$_d" >> "$T/jres"
              continue
            fi
            _e=$(printf '%s' "$_e" | tr -d '\000-\037\177'); _f=$(printf '%s' "$_f" | tr -d '\000-\037\177'); _g=$(printf '%s' "$_g" | tr -d '\000-\037\177')
            printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$_a" "$_c" "$_d" "$_e" "$_f" "$_g" "$_h" >> "$T/jres"
            ;;
        esac
        ;;
      K)
        # BT31: K id open | denied | fired "quoted firedText". A fired record the relay cannot read is still the watch's fire: it is kept
        # as "-" (a plain line), so it neither loops nor is lost.
        case $_a in ''|*[!A-Za-z0-9_-]*) continue ;; esac
        [ ${#_a} -le 64 ] || continue
        case $_b in
          denied) printf '%s\n' "$_a" >> "$T/wden" ;;
          fired)
            _c=$(printf '%s' "$_c" | tr -d '\r')
            case $_c in \"*\") if [ ${#_c} -ge 2 ] && [ ${#_c} -le 2200 ]; then _c=$(printf '%s' "$_c" | tr -d '\000-\037\177'); else _c=-; fi ;; *) _c=- ;; esac
            printf '%s\t%s\n' "$_a" "$_c" >> "$T/wres"
            ;;
        esac
        ;;
      T)
        case $_a in ''|*[!A-Za-z0-9_-]*) continue ;; esac
        case $_b in denied|gone) printf '%s %s\n' "$_a" "$_now" >> "$T/skip"; retire_follow "$_a" ;; esac
        ;;
      N)
        # A notice: N id urgent refs title body. urgent is 0 or 1, refs are ids (or "-"), title and body are quoted strings.
        case $_a in ''|*[!A-Za-z0-9-]*) continue ;; esac
        [ ${#_a} -le 64 ] || continue
        case $_b in 0|1) ;; *) continue ;; esac
        case $_c in ''|*[!A-Za-z0-9_,-]*) continue ;; esac
        _ok=1
        _oldifs=$IFS; IFS=,
        for _r in $_c; do [ ${#_r} -le 64 ] || _ok=0; done
        IFS=$_oldifs
        _e=$(printf '%s' "$_e" | tr -d '\r')
        case $_d in \"*\") [ ${#_d} -ge 2 ] || _ok=0 ;; *) _ok=0 ;; esac
        # The body is the server's lines joined by " | ", each one built from quoted parts: it starts with one of the four line openings.
        case $_e in "New report on \""*|"New decision on \""*|"Decided on \""*|"Withdrawn on \""*) [ ${#_e} -le 6000 ] || _ok=0 ;; *) _ok=0 ;; esac
        [ "$_ok" = 1 ] || continue
        _d=$(printf '%s' "$_d" | tr -d '\000-\037\177')
        _e=$(printf '%s' "$_e" | tr -d '\000-\037\177')
        printf '%s\t%s\t%s\t%s\t%s\n' "$_a" "$_b" "$_c" "$_d" "$_e" >> "$T/notices"
        ;;
      M)
        case $_a in ''|*[!A-Za-z0-9-]*) continue ;; esac
        [ ${#_a} -le 64 ] || continue
        _d=$(printf '%s' "$_d" | tr -d '\r')
        _ok=1
        for _f in "$_b" "$_c" "$_d"; do
          case $_f in \"*\") [ ${#_f} -ge 2 ] || _ok=0 ;; *) _ok=0 ;; esac
        done
        [ "$_ok" = 1 ] || continue
        _b=$(printf '%s' "$_b" | tr -d '\000-\037\177')
        _c=$(printf '%s' "$_c" | tr -d '\000-\037\177')
        _d=$(printf '%s' "$_d" | tr -d '\000-\037\177')
        printf '%s\t%s\t%s\t%s\n' "$_a" "$_b" "$_c" "$_d" >> "$T/msgs"
        ;;
    esac
  done < "$T/body"
}
jesc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
PREAMBLE="(data, not your user's words)"
# Builds the JSON text of one user turn from $T/new (lines "id TAB from TAB title TAB body"); at most 20 messages. Sets TEXT and IDS.
build_text() {
  TEXT=; IDS=; _c=0
  while IFS=$TAB read -r _id _from _title _body; do
    [ "$_c" -lt 20 ] || break
    _one="Mind: $(jesc "$_from") on task $(jesc "$_title") $PREAMBLE:\\n$(jesc "$_body")"
    TEXT="${TEXT:+$TEXT\\n\\n}$_one"
    IDS="${IDS:+$IDS }$_id"
    _c=$((_c + 1))
  done < "$T/new"
  # A message posts at once and carries the notices that are waiting (they are not counted as a notice-only turn).
  NIDS=
  if [ -z "$paused" ] && [ -s "$pendingf" ]; then
    build_notice_text
    if [ -n "$NIDS" ]; then TEXT="${TEXT:+$TEXT\\n\\n}$NTEXT"; fi
  fi
  # A held watch result rides the turn too (BT31); the caller closes it only when the turn posted.
  watch_text
  if [ -n "$WIDS" ]; then TEXT="${TEXT:+$TEXT\\n\\n}$WTEXT"; fi
}
# Of $T/msgs: the ones not yet written into the session go to $T/new, the ones that only need their ack to $T/ackonly.
split_new() {
  : > "$T/new"; : > "$T/ackonly"
  while IFS=$TAB read -r _id _rest; do
    if grep -qx -- "$_id" "$deliveredf" 2>/dev/null; then printf '%s\n' "$_id" >> "$T/ackonly"; else printf '%s\t%s\n' "$_id" "$_rest" >> "$T/new"; fi
  done < "$T/msgs"
}
remember() { # ids posted into the session, kept so a lost ack never means a second post
  for _i in $1; do printf '%s\n' "$_i" >> "$deliveredf"; done
  tail -n 200 "$deliveredf" > "$deliveredf.tmp.$$" 2>/dev/null && mv -f "$deliveredf.tmp.$$" "$deliveredf"
}

# ---------------------------------------------------------------- follows and notices (BT18-BT21)
# A denied or gone task that this relay holds ONLY through a follow: write the expiry-0 line itself, so a dead follow stops taking a poll slot.
retire_follow() {
  while read -r _ft _fs _fsid; do
    [ "$_ft" = "$1" ] || continue
    printf '%s\t%s\t%s\t0\n' "$(date +%s)" "$_fs" "$_ft" >> "$dir/sessions/$_fsid.follow"
  done < "$T/fo"
}
# The ids this session (every id on this socket) wrote itself: a notice line about one of them is dropped.
collect_own() {
  : > "$T/own"
  [ -f "$sidsf" ] || return 0
  while read -r _sid; do
    case $_sid in ''|*[!A-Za-z0-9_-]*) continue ;; esac
    [ -f "$dir/sessions/$_sid.own" ] && cat "$dir/sessions/$_sid.own" >> "$T/own"
  done < "$sidsf"
}
# Prints the body with the lines about this session's own reports removed, lines being split on " | " OUTSIDE quotes. Prints nothing when
# no line with a ref is left (nothing to say); the trailing "and N more" line has no ref and never keeps a notice alive.
# The body travels in the environment: awk -v would turn \" back into ".
drop_own() { # drop_own BODY REFS
  RB=$1 RR=$2 awk -v ownf="$T/own" 'BEGIN {
    body = ENVIRON["RB"]; refs = ENVIRON["RR"]
    while ((getline l < ownf) > 0) own[l] = 1
    nr = (refs == "-" || refs == "") ? 0 : split(refs, R, ",")
    if (nr == 0) { print body; exit }
    n = 0; cur = ""; inq = 0; i = 1; L = length(body)
    while (i <= L) {
      c = substr(body, i, 1)
      if (c == "\\" && inq) { cur = cur c substr(body, i + 1, 1); i += 2; continue }
      if (c == "\"") inq = !inq
      if (!inq && substr(body, i, 3) == " | ") { parts[++n] = cur; cur = ""; i += 3; continue }
      cur = cur c; i++
    }
    parts[++n] = cur
    out = ""; kept = 0
    for (j = 1; j <= n; j++) {
      # Only a line about the own report or raise of this session is dropped. A "Decided on" or "Withdrawn on" line carries the decision id,
      # which IS in the own file for whoever raised it, and that person must hear the ruling.
      if (j <= nr && (R[j] in own) && (index(parts[j], "New report on \"") == 1 || index(parts[j], "New decision on \"") == 1)) continue
      if (j <= nr) kept++
      out = out (out == "" ? "" : " | ") parts[j]
    }
    if (kept > 0) print out
  }'
}
# Moves what $T/notices holds into the pending file and records every received id in $T/noticeack (acked on receipt, so a notice held
# back never comes back on a poll). Already delivered or already pending ids are only acked.
take_notices() {
  [ -s "$T/notices" ] || return 0
  collect_own
  _now=$(date +%s)
  while IFS=$TAB read -r _id _urg _refs _title _body; do
    grep -qx -- "$_id" "$T/noticeack" 2>/dev/null || printf '%s\n' "$_id" >> "$T/noticeack"
    grep -qx -- "$_id" "$deliveredf" 2>/dev/null && continue
    awk -F"$TAB" -v id="$_id" '$2 == id { f = 1 } END { exit !f }' "$pendingf" && continue
    _kept=$(drop_own "$_body" "$_refs")
    [ -n "$_kept" ] || continue
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$_now" "$_id" "$_urg" "$_refs" "$_title" "$_kept" >> "$pendingf"
  done < "$T/notices"
  trim_pending
}
# At most 100 held notices: the oldest PLAIN ones go first, urgent ones last.
trim_pending() {
  awk -F"$TAB" -v max=100 'NR == FNR { if ($3 == 1) u++; else pl++; next }
    { if ($3 == 1) { if (u <= max || ++su > u - max) print }
      else { keep = max - (u > max ? max : u); if (++sp > pl - keep) print } }' "$pendingf" "$pendingf" > "$pendingf.tmp.$$" 2>/dev/null && mv -f "$pendingf.tmp.$$" "$pendingf"
}
# A notice is delivered for 24 hours; the relay keeps its own copy only as long.
pending_expire() {
  [ -s "$pendingf" ] || return 0
  awk -F"$TAB" -v min="$(($(date +%s) - NOTICE_TTL))" '$1 + 0 >= min' "$pendingf" > "$pendingf.tmp.$$" 2>/dev/null && mv -f "$pendingf.tmp.$$" "$pendingf"
}
# Is a notice-only turn allowed now? $1 = 1 when the turn holds an urgent notice. 6 an hour (plain ones may use all but 2) and 40 a day.
caps_ok() {
  awk -v now="$(date +%s)" -v u="$1" -v H="$CAP_HOUR" -v P="$CAP_PLAIN" -v D="$CAP_DAY" '
    { if (now - $1 < 86400) d++; if (now - $1 < 3600) { h++; if ($2 == 0) p++ } }
    END { exit !(d < D && h < H && (u == 1 || p < P)) }' "$postsf"
}
# Builds the JSON text of the pending notices (at most 20) into NTEXT and their ids into NIDS, and sets NURGENT when one is urgent.
build_notice_text() {
  NTEXT=; NIDS=; NURGENT=0; _c=0
  # Urgent notices first, so a turn that is cut at 20 never leaves an urgent one behind.
  { awk -F"$TAB" '$3 == 1' "$pendingf"; awk -F"$TAB" '$3 != 1' "$pendingf"; } > "$T/pend.sorted"
  while IFS=$TAB read -r _ep _id _urg _refs _title _body; do
    [ "$_c" -lt 20 ] || break
    _one="Mind notice, task $(jesc "$_title") $PREAMBLE:\\n$(jesc "$_body")"
    NTEXT="${NTEXT:+$NTEXT\\n\\n}$_one"
    NIDS="${NIDS:+$NIDS }$_id"
    [ "$_urg" = 1 ] && NURGENT=1
    _c=$((_c + 1))
  done < "$T/pend.sorted"
}
forget_pending() { # ids just posted
  awk -F"$TAB" -v ids=" $1 " 'index(ids, " " $2 " ") == 0' "$pendingf" > "$pendingf.tmp.$$" 2>/dev/null && mv -f "$pendingf.tmp.$$" "$pendingf"
}
# Seconds until the held notices are due (0 = now): an urgent one is due at once, else 3 minutes after the oldest arrived. Prints nothing when none are held.
notice_wait() {
  [ -s "$pendingf" ] || return 0
  awk -F"$TAB" -v now="$(date +%s)" -v hold="$NOTICE_HOLD" '
    NR == 1 || $1 < oldest { oldest = $1 }
    $3 == 1 { u = 1 }
    END { w = oldest + hold - now; if (u || w < 0) w = 0; print w }' "$pendingf"
}
# A notice-only turn, when one is due and allowed. Returns 0 when it posted.
post_due_notices() {
  [ -s "$pendingf" ] || return 1
  [ -z "$paused" ] || return 1
  [ "$(notice_wait)" = 0 ] || return 1
  build_notice_text
  [ -n "$NIDS" ] || return 1
  caps_ok "$NURGENT" || return 1
  if ! post_line "$NTEXT"; then fail || exit 0; return 1; fi
  remember "$NIDS"
  forget_pending "$NIDS"
  printf '%s %s\n' "$(date +%s)" "$NURGENT" >> "$postsf"
  tail -n 100 "$postsf" > "$postsf.tmp.$$" 2>/dev/null && mv -f "$postsf.tmp.$$" "$postsf"
  return 0
}

# ---------------------------------------------------------------- job results (BT23)
# The session is idle while the Stop hook's stamp (idle-at) is not older than the last tool call's (busy-at): the same rule mark_posted uses.
session_idle() {
  _ia=0; _ba=0
  read -r _ia < "$dir/relays/$key.idle-at" 2>/dev/null
  read -r _ba < "$dir/relays/$key.busy-at" 2>/dev/null
  case $_ia in ''|*[!0-9]*) _ia=0 ;; esac
  case $_ba in ''|*[!0-9]*) _ba=0 ;; esac
  [ "$_ia" -gt 0 ] && [ "$_ia" -ge "$_ba" ]
}
# Every line of every session's .jobs file on this socket, each led by its session id, into $T/jstream.
jobs_stream() {
  : > "$T/jstream"
  [ -f "$sidsf" ] || return 0
  while read -r _sid; do
    case $_sid in ''|*[!A-Za-z0-9_-]*) continue ;; esac
    [ -f "$dir/sessions/$_sid.jobs" ] || continue
    awk -v s="$_sid" '{ print s, $0 }' "$dir/sessions/$_sid.jobs" >> "$T/jstream"
  done < "$sidsf"
}
# What to do with the group lines (J) minus the closed ids (D), given the ended results held in the jended file. Prints
#   W id           an open id to poll (the newest 20; an id held back as ended is not sent)
#   Q sid id       close the id silently (dropped past 20 open ids, or a cancel with nothing else to report)
#   P sid id...    post the held results of a group: all of it ended, or one of it failed / is BLOCKED / gave up
#   R sid id...    a line older than 7 days: stop watching these open ids, with one turn
#   X id           JO6: a PR id to poll as prjobs (an R line with no D: the newest 20, each under 7 days old)
jobs_plan() {
  awk -v now="$(date +%s)" -v retire="$JOB_RETIRE" -v cachef="$jendedf" '
    BEGIN { while ((getline l < cachef) > 0) { n = split(l, a, "\t"); if (n >= 2) cache[a[1]] = a[2] } }
    $2 == "D" && NF >= 3 { done[$1 " " $3] = 1; dd[$1 " " $3] = 1; next }
    $2 == "R" && NF >= 4 && $3 ~ /^[0-9]+$/ && $4 ~ /^[A-Za-z0-9_-]+$/ && length($4) <= 64 { done[$1 " " $4] = 1; rs[$1 " " $4] = $3 + 0; next }
    $2 == "J" && $3 ~ /^[0-9]+$/ {
      g++; gs[g] = $1; ge[g] = $3 + 0
      for (i = 4; i <= NF; i++) if ($i ~ /^[A-Za-z0-9_-]+$/ && length($i) <= 64) gid[g, ++gn[g]] = $i
    }
    END {
      # JO6: the PR list: the ids of R lines with no D and under 7 days old, newest 20, one per id.
      for (k in rs) {
        split(k, kp, " "); if ((k in dd) || now - rs[k] >= retire || (kp[2] in pseen)) continue
        pseen[kp[2]] = 1; pc++; pe[pc] = rs[k]; pi[pc] = kp[2]
      }
      for (i = 2; i <= pc; i++) {
        te = pe[i]; ti = pi[i]; j = i - 1
        while (j >= 1 && (pe[j] < te || (pe[j] == te && pi[j] > ti))) { pe[j + 1] = pe[j]; pi[j + 1] = pi[j]; j-- }
        pe[j + 1] = te; pi[j + 1] = ti
      }
      for (i = 1; i <= 20 && i <= pc; i++) print "X", pi[i]
      c = 0
      for (x = 1; x <= g; x++) for (k = 1; k <= gn[x]; k++) {
        id = gid[x, k]; key = gs[x] " " id
        if ((key in done) || (key in seen)) continue
        seen[key] = 1
        if (id in cache) continue
        c++; ce[c] = ge[x]; cg[c] = x; ck[c] = k; cs[c] = gs[x]; ci[c] = id
      }
      for (i = 2; i <= c; i++) {
        te = ce[i]; tg = cg[i]; tk = ck[i]; ts = cs[i]; ti = ci[i]; j = i - 1
        while (j >= 1 && (ce[j] > te || (ce[j] == te && (cg[j] > tg || (cg[j] == tg && ck[j] > tk))))) {
          ce[j + 1] = ce[j]; cg[j + 1] = cg[j]; ck[j + 1] = ck[j]; cs[j + 1] = cs[j]; ci[j + 1] = ci[j]; j--
        }
        ce[j + 1] = te; cg[j + 1] = tg; ck[j + 1] = tk; cs[j + 1] = ts; ci[j + 1] = ti
      }
      drop = c - 20
      for (i = 1; i <= drop; i++) { print "Q", cs[i], ci[i]; done[cs[i] " " ci[i]] = 1 }
      for (x = 1; x <= g; x++) {
        nopen = 0; op = ""; u = ""; urgent = 0; nonc = 0
        for (k = 1; k <= gn[x]; k++) {
          id = gid[x, k]; key = gs[x] " " id
          if ((key in done) || ((x SUBSEP id) in once)) continue
          once[x, id] = 1
          if (id in cache) { u = u " " id; if (cache[id] == "u") urgent = 1; if (cache[id] != "c") nonc = 1 }
          else { nopen++; op = op " " id }
        }
        if (nopen > 0 && now - ge[x] >= retire) {
          print "R", gs[x] op
          nn = split(op, o, " "); for (m = 1; m <= nn; m++) done[gs[x] " " o[m]] = 1
          nopen = 0
        }
        if (u != "") {
          if (nonc && (nopen == 0 || urgent)) print "P", gs[x] u
          else if (nopen == 0) { nn = split(u, o, " "); for (m = 1; m <= nn; m++) print "Q", gs[x], o[m] }
        }
      }
      for (i = (drop > 0 ? drop + 1 : 1); i <= c; i++) if (!((cs[i] " " ci[i]) in done) && !(ci[i] in wseen)) { wseen[ci[i]] = 1; print "W", ci[i] }
    }' "$T/jstream"
}
# Close ids in one session's file (append only) and forget their held results.
jobs_close_ids() { # sid ids...
  _cs=$1; shift
  for _ci in "$@"; do
    case $_ci in ''|*[!A-Za-z0-9_-]*) continue ;; esac
    printf 'D %s\n' "$_ci" >> "$dir/sessions/$_cs.jobs"
  done
  jobs_uncache "$@"
}
jobs_uncache() {
  [ -s "$jendedf" ] || return 0
  awk -F"$TAB" -v ids=" $* " 'index(ids, " " $1 " ") == 0' "$jendedf" > "$jendedf.tmp.$$" 2>/dev/null && mv -f "$jendedf.tmp.$$" "$jendedf"
}
# An id the server called denied (not this person's, or gone): close it in every session file that holds it.
jobs_close_denied() {
  awk -v id="$1" '$2 == "J" { for (i = 4; i <= NF; i++) if ($i == id) { print $1; break } } $2 == "R" && $4 == id { print $1 }' "$T/jstream" | sort -u | while read -r _ds; do
    case $_ds in ''|*[!A-Za-z0-9_-]*) continue ;; esac
    grep -qx -- "D $1" "$dir/sessions/$_ds.jobs" 2>/dev/null || printf 'D %s\n' "$1" >> "$dir/sessions/$_ds.jobs"
  done
}
# JO6: a settled PR: write D only in the sessions that hold an R line for the id (another session's held result is still to be posted).
jobs_close_settled() {
  awk -v id="$1" '$2 == "R" && $4 == id { print $1 }' "$T/jstream" | sort -u | while read -r _ds; do
    case $_ds in ''|*[!A-Za-z0-9_-]*) continue ;; esac
    grep -qx -- "D $1" "$dir/sessions/$_ds.jobs" 2>/dev/null || printf 'D %s\n' "$1" >> "$dir/sessions/$_ds.jobs"
  done
}
# Job turns have their own cap, apart from the notice caps: 12 an hour, 60 a day.
job_caps_ok() {
  awk -v now="$(date +%s)" '{ if (now - $1 < 86400) d++; if (now - $1 < 3600) h++ } END { exit !(d < 60 && h < 12) }' "$jpostsf"
}
job_posted() {
  printf '%s\n' "$(date +%s)" >> "$jpostsf"
  tail -n 100 "$jpostsf" > "$jpostsf.tmp.$$" 2>/dev/null && mv -f "$jpostsf.tmp.$$" "$jpostsf"
}
# One turn for a group: a line per held result. Returns 1 when it could not post (paused, over the cap, or the socket refused).
jobs_turn() { # sid ids...
  _ts=$1; shift
  _text=; _used=
  for _ti in "$@"; do
    _l=$(awk -F"$TAB" -v id="$_ti" '$1 == id { print $4; exit }' "$jendedf")
    [ -n "$_l" ] || continue
    _text="${_text:+$_text\\n}- $(jesc "$_l")"
    _used="$_used $_ti"
  done
  [ -n "$_used" ] || return 0
  [ -z "$paused" ] || return 1
  job_caps_ok || return 1
  # A held watch result rides this turn: one turn per poll (BT31).
  watch_text
  if ! post_line "Mind jobs $PREAMBLE:\\n$_text${WIDS:+\\n\\n$WTEXT}"; then fail || exit 0; return 1; fi
  job_posted
  # JO6: a done-with-PR result becomes R <epoch> <id> (the PR is still followed); every other one is closed with D.
  _dl=; _tn=$(date +%s)
  for _ti in $_used; do
    if [ "$(awk -F"$TAB" -v id="$_ti" '$1 == id { print $5; exit }' "$jendedf")" = 1 ]; then
      printf 'R %s %s\n' "$_tn" "$_ti" >> "$dir/sessions/$_ts.jobs"
      jobs_uncache "$_ti"
    else _dl="$_dl $_ti"; fi
  done
  # shellcheck disable=SC2086
  [ -z "$_dl" ] || jobs_close_ids "$_ts" $_dl
  [ -z "$WIDS" ] || watch_done
}
# JO6: one turn for a red PR, per (id, nudgeAt). The key goes in the file of the session that holds the id's R line, so a restart does not
# post it twice. Returns 1 when it could not post (paused, over the cap, socket refused; the next poll hands the record back), 2 when there is
# nothing to post (already posted, or no R line holds the id).
jobs_nudge() { # id pr checks nudgeAt
  _ns=$(awk -v id="$1" '$2 == "R" && $4 == id { print $1; exit }' "$T/jstream")
  case $_ns in ''|@|*[!A-Za-z0-9_-]*) return 2 ;; esac
  _nk="$1@$4"
  grep -qxF -- "T $_nk" "$dir/sessions/$_ns.jobs" 2>/dev/null && return 2
  [ -z "$paused" ] || return 1
  job_caps_ok || return 1
  if [ "$3" = "merge conflict" ]; then _nr="a merge conflict"; elif [ "$3" = "required checks" ]; then _nr="required checks red"; else _nr="required checks \`$(jesc "$3")\` red"; fi
  if ! post_line "Mind nudge $PREAMBLE:\\nJob \`$1\`: PR #$2 has had $_nr for 20 min. Push a fix in 5 min and the Mind waits 30 min for green. Else the Mind fixes it (turn auto-merge off to leave it)."; then fail || exit 0; return 1; fi
  job_posted
  printf 'T %s\n' "$_nk" >> "$dir/sessions/$_ns.jobs"
}
jobs_retire() { # sid ids...
  _rs=$1; shift
  [ -z "$paused" ] || return 1
  job_caps_ok || return 1
  _ids=$(printf '%s ' "$@")
  if ! post_line "Mind jobs $PREAMBLE:\\nLost track of job ${_ids% } after 7 days. Check it with get_job."; then fail || exit 0; return 1; fi
  job_posted
  jobs_close_ids "$_rs" "$@"
}
# Reads the plan and does it. Sets JOBPOLL (comma list of the open ids to poll).
JOBPOLL=
JOBPR=
jobs_flush() {
  JOBPOLL=; JOBPR=
  jobs_stream
  jobs_plan > "$T/jplan"
  while read -r _t _s _rest; do
    case $_s in ''|*[!A-Za-z0-9_-]*) continue ;; esac
    # shellcheck disable=SC2086
    case $_t in
      W) JOBPOLL=${JOBPOLL:+$JOBPOLL,}$_s ;;
      X) JOBPR=${JOBPR:+$JOBPR,}$_s ;;
      Q) jobs_close_ids $_s $_rest ;;
      P) jobs_turn $_s $_rest ;;
      R) jobs_retire $_s $_rest ;;
    esac
  done < "$T/jplan"
  return 0
}
# After a poll: what the server said about the jobs. Denied ids are closed; an ended result is held (jended) until its group posts.
JPROG=
take_jobs() {
  JPROG=
  if [ -s "$T/jden" ]; then
    while read -r _i; do jobs_close_denied "$_i"; done < "$T/jden"
    JPROG=1
  fi
  if [ -s "$T/jset" ]; then
    while read -r _i; do jobs_close_settled "$_i"; done < "$T/jset"
    JPROG=1
  fi
  if [ -s "$T/jred" ]; then
    while IFS=$TAB read -r _ri _rp _rc _rn; do
      jobs_nudge "$_ri" "$_rp" "$_rc" "$_rn" && JPROG=1 || :
    done < "$T/jred"
  fi
  [ -s "$T/jres" ] || return 0
  _tn=$(date +%s)
  while IFS=$TAB read -r _i _kind _out _lab _url _rea _spend; do
    awk -F"$TAB" -v id="$_i" '$1 == id { f = 1 } END { exit !f }' "$jendedf" && continue
    case $_out in FAIL|BLOCKED|failed) _fl=u ;; cancelled) _fl=c ;; *) _fl=p ;; esac
    if [ "$_kind" = plain ]; then
      _line="job $_i ended: $_out; read it with get_job"
    else
      _line="job $_i ($_kind) $_out"
      [ "$_lab" = - ] || _line="$_line: $_lab"
      [ "$_url" = - ] || _line="$_line; link $_url"
      [ "$_rea" = - ] || _line="$_line; reason $_rea"
      [ "$_spend" = - ] || _line="$_line; spend USD $_spend"
    fi
    # JO6: a done result with a PR link is followed after it posts (R, not D).
    _pr=0
    if [ "$_kind" != plain ] && [ "$_out" = done ]; then case $_url in */pull/[0-9]*) _pr=1 ;; esac; fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$_i" "$_fl" "$_tn" "$_line" "$_pr" >> "$jendedf"
    JPROG=1
  done < "$T/jres"
  # A held result nobody asked for in 8 days is not kept (its line was retired or its session is gone).
  awk -F"$TAB" -v min="$((_tn - 691200))" '$3 + 0 >= min' "$jendedf" > "$jendedf.tmp.$$" 2>/dev/null && mv -f "$jendedf.tmp.$$" "$jendedf"
}

# ---------------------------------------------------------------- watches (BT27-BT37)
# Every line of this socket's relays/KEY.watches (led by "@", PP20 a: the hook and the CLI write here, so two session ids for one session cannot lose a
# watch) and of every session's old sessions/<id>.watches on this socket (migration), each led by its session id, into $T/wstream.
watches_stream() {
  : > "$T/wstream"
  [ ! -f "$kwatchesf" ] || awk '{ print "@", $0 }' "$kwatchesf" >> "$T/wstream"
  [ -f "$sidsf" ] || return 0
  while read -r _sid; do
    case $_sid in ''|*[!A-Za-z0-9_-]*) continue ;; esac
    [ -f "$dir/sessions/$_sid.watches" ] || continue
    awk -v s="$_sid" '{ print s, $0 }' "$dir/sessions/$_sid.watches" >> "$T/wstream"
  done < "$sidsf"
}
# The ids to poll, newest first, at most 20: a W line with no D for its session, and not held as fired (a held id is never sent again).
watches_open() {
  awk -v cachef="$wendedf" '
    BEGIN { while ((getline l < cachef) > 0) { n = split(l, a, "\t"); if (n >= 2) cache[a[1]] = 1 } }
    $2 == "D" && NF >= 3 { done[$1 " " $3] = 1; next }
    $2 == "W" && $3 ~ /^[0-9]+$/ && $4 ~ /^[A-Za-z0-9_-]+$/ && length($4) <= 64 { c++; ce[c] = $3 + 0; cs[c] = $1; ci[c] = $4 }
    END {
      for (i = 1; i <= c; i++) {
        if (((cs[i] " " ci[i]) in done) || (ci[i] in cache) || (ci[i] in seen)) continue
        seen[ci[i]] = 1; m++; ee[m] = ce[i]; ii[m] = ci[i]
      }
      for (k = 1; k <= 20 && k <= m; k++) {
        b = 0
        for (i = 1; i <= m; i++) if (!(i in used) && (b == 0 || ee[i] > ee[b])) b = i
        used[b] = 1; print ii[b]
      }
    }' "$T/wstream"
}
watches_uncache() {
  [ -s "$wendedf" ] || return 0
  awk -F"$TAB" -v ids=" $* " 'index(ids, " " $1 " ") == 0' "$wendedf" > "$wendedf.tmp.$$" 2>/dev/null && mv -f "$wendedf.tmp.$$" "$wendedf"
}
# Close one id in every session file that holds it (append only) and forget its held result.
watch_close() {
  awk -v id="$1" '$2 == "W" && $4 == id { print $1 }' "$T/wstream" | sort -u | while read -r _ds; do
    if [ "$_ds" = @ ]; then
      grep -qx -- "D $1" "$kwatchesf" 2>/dev/null || printf 'D %s\n' "$1" >> "$kwatchesf"
      continue
    fi
    case $_ds in ''|*[!A-Za-z0-9_-]*) continue ;; esac
    grep -qx -- "D $1" "$dir/sessions/$_ds.watches" 2>/dev/null || printf 'D %s\n' "$1" >> "$dir/sessions/$_ds.watches"
  done
  watches_uncache "$1"
}
# Sets WTEXT (JSON text, led by the fixed preamble) and WIDS from the held fired results, at most 20. Both stay empty while paused or over the
# job-turn cap, so a held result is neither sent nor lost.
watch_text() {
  WTEXT=; WIDS=
  [ -s "$wendedf" ] || return 0
  [ -z "$paused" ] || return 0
  job_caps_ok || return 0
  _wc=0
  while IFS=$TAB read -r _wi _we _wl; do
    [ "$_wc" -lt 20 ] || break
    WTEXT="${WTEXT:+$WTEXT\\n}- $(jesc "$_wl")"
    WIDS="${WIDS:+$WIDS }$_wi"
    _wc=$((_wc + 1))
  done < "$wendedf"
  [ -z "$WIDS" ] || WTEXT="Mind watches $PREAMBLE:\\n$WTEXT"
}
# The ids of a posted turn are closed (D) in their session files.
watch_done() {
  watches_stream
  for _wi in $WIDS; do watch_close "$_wi"; done
  WIDS=
}
# A turn of its own for held results, when no other turn of this poll carried them. Returns 1 when it could not post.
watches_flush() {
  watch_text
  [ -n "$WIDS" ] || return 0
  if ! post_line "$WTEXT"; then fail || exit 0; return 1; fi
  job_posted
  watch_done
}
# After a poll: denied ids are closed; a fired result is held (wended) until a turn posts it.
WPROG=
take_watches() {
  WPROG=
  if [ -s "$T/wden" ]; then
    while read -r _i; do watch_close "$_i"; done < "$T/wden"
    WPROG=1
  fi
  [ -s "$T/wres" ] || return 0
  _tn=$(date +%s)
  while IFS=$TAB read -r _i _txt; do
    awk -F"$TAB" -v id="$_i" '$1 == id { f = 1 } END { exit !f }' "$wendedf" && continue
    if [ "$_txt" = - ]; then _line="$_i fired (see list_watches)"; else _line="$_i: $_txt"; fi
    printf '%s\t%s\t%s\n' "$_i" "$_tn" "$_line" >> "$wendedf"
    WPROG=1
  done < "$T/wres"
  # A held result nobody took in 8 days is not kept (its session is gone).
  awk -F"$TAB" -v min="$((_tn - 691200))" '$2 + 0 >= min' "$wendedf" > "$wendedf.tmp.$$" 2>/dev/null && mv -f "$wendedf.tmp.$$" "$wendedf"
}

# ---------------------------------------------------------------- a resumed session, and old files
# A resumed session keeps its id but gets a new socket, so a new key: the notices an older relay of the same session had already acked
# (the pending file) would be lost with the old key. Take them, and what that relay had delivered and posted, over: from any key that
# shares a session id with this one and has no live relay. The old key's files are then removed.
adopt_old() {
  [ -f "$sidsf" ] || return 0
  for _of in "$dir"/relays/*.sids; do
    [ -f "$_of" ] || continue
    _ok=${_of##*/}; _ok=${_ok%.sids}
    case $_ok in ''|*[!0-9]*) continue ;; esac
    [ "$_ok" != "$key" ] || continue
    _op=
    [ -f "$dir/relays/$_ok.pid" ] && read -r _op < "$dir/relays/$_ok.pid"
    case $_op in ''|*[!0-9]*) ;; *) if kill -0 "$_op" 2>/dev/null; then continue; fi ;; esac
    _shared=0
    while read -r _s; do
      case $_s in ''|*[!A-Za-z0-9_-]*) continue ;; esac
      grep -qx -- "$_s" "$_of" 2>/dev/null && _shared=1
    done < "$sidsf"
    [ "$_shared" = 1 ] || continue
    if [ -f "$dir/relays/$_ok.pending" ]; then
      while IFS=$TAB read -r _ep _id _rest; do
        case $_id in ''|*[!A-Za-z0-9-]*) continue ;; esac
        awk -F"$TAB" -v id="$_id" '$2 == id { f = 1 } END { exit !f }' "$pendingf" && continue
        grep -qx -- "$_id" "$deliveredf" 2>/dev/null && continue
        printf '%s\t%s\t%s\n' "$_ep" "$_id" "$_rest" >> "$pendingf"
      done < "$dir/relays/$_ok.pending"
    fi
    # Watches too (PP20 a): the old key's open W lines (no D for the id) go to this key's file, and its held fired results with them.
    if [ -f "$dir/relays/$_ok.watches" ]; then
      awk '$1 == "D" { d[$2] = 1; next } $1 == "W" { l[++n] = $0; i[n] = $3 } END { for (k = 1; k <= n; k++) if (!(i[k] in d)) print l[k] }' "$dir/relays/$_ok.watches" | while IFS= read -r _wl; do
        grep -qxF -- "$_wl" "$kwatchesf" 2>/dev/null || printf '%s\n' "$_wl" >> "$kwatchesf"
      done
    fi
    if [ -f "$dir/relays/$_ok.wended" ]; then
      while IFS= read -r _el; do
        _ei=${_el%%"$TAB"*}
        awk -F"$TAB" -v id="$_ei" '$1 == id { f = 1 } END { exit !f }' "$wendedf" || printf '%s\n' "$_el" >> "$wendedf"
      done < "$dir/relays/$_ok.wended"
    fi
    [ -f "$dir/relays/$_ok.delivered" ] && cat "$dir/relays/$_ok.delivered" >> "$deliveredf"
    [ -f "$dir/relays/$_ok.posts" ] && cat "$dir/relays/$_ok.posts" >> "$postsf"
    rm -f "$dir/relays/$_ok".pending "$dir/relays/$_ok".delivered "$dir/relays/$_ok".posts "$dir/relays/$_ok".left "$dir/relays/$_ok".status "$dir/relays/$_ok".sids "$dir/relays/$_ok".pid "$dir/relays/$_ok".watches "$dir/relays/$_ok".wended
  done
  sort -n "$postsf" 2>/dev/null | tail -n 100 > "$postsf.tmp.$$" && mv -f "$postsf.tmp.$$" "$postsf"
  tail -n 200 "$deliveredf" > "$deliveredf.tmp.$$" 2>/dev/null && mv -f "$deliveredf.tmp.$$" "$deliveredf"
  sort -n "$pendingf" 2>/dev/null > "$pendingf.tmp.$$" && mv -f "$pendingf.tmp.$$" "$pendingf"
  trim_pending
}
# Files of relays that are gone and were last touched more than 25 hours ago (a notice lives 24 hours, and the 40-a-day count 24):
# pending, posts, delivered and the rest. A live relay's files are never touched.
tidy_relays() {
  find "$dir/relays" -type f -mmin +1500 2>/dev/null | while read -r _f; do
    _b=${_f##*/}; _k=${_b%%.*}
    case $_k in ''|*[!0-9]*) continue ;; esac
    [ "$_k" != "$key" ] || continue
    _p=
    [ -f "$dir/relays/$_k.pid" ] && read -r _p < "$dir/relays/$_k.pid"
    case $_p in ''|*[!0-9]*) ;; *) if kill -0 "$_p" 2>/dev/null; then continue; fi ;; esac
    rm -f "$_f"
  done
  for _d in "$dir"/relays/*.lock; do
    [ -d "$_d" ] && [ -n "$(find "$_d" -maxdepth 0 -mmin +1500 2>/dev/null)" ] && rmdir "$_d" 2>/dev/null
  done
}

# ---------------------------------------------------------------- the loop
adopt_old
tidy_relays
last_probe=$(date +%s)
while :; do
  alive || exit 0
  # Two relays that passed the "live one wins" check in the same moment both wrote a pid; the last write wins and the other leaves here, before
  # its first poll (start-up work between the pid write and this line takes longer than the gap between the two writes).
  read -r _mine < "$pidf" || _mine=
  [ -z "$_mine" ] || [ "$_mine" = "$$" ] || { trap - EXIT; exit 0; }
  maybe_reload
  settle_wakes
  gate
  IDS=; NIDS=
  : > "$T/noticeack"
  _now=$(date +%s)
  if [ $((_now - last_probe)) -ge "$PROBE_EVERY" ]; then
    probe_alive || exit 0
    last_probe=$_now
  fi
  find_origin || exit 0 # signed out, or not holding a relay token
  pending_expire
  # Held notices that are due (3 minutes old, or urgent) go out before anything else.
  post_due_notices
  # BT23: held job results that are due go out, and the open job ids to poll come out of the same pass.
  jobs_flush
  watches_flush
  watches_stream
  WATCHPOLL=$(watches_open | tr '\n' ',')
  WATCHPOLL=${WATCHPOLL%,}
  tasks=$(collect_tasks)
  if [ -z "$tasks" ] && [ -z "$JOBPOLL" ] && [ -z "$JOBPR" ] && [ -z "$WATCHPOLL" ]; then
    # Nothing to poll for. The loop is healthy, signed in and listening: `mind-checkin status --here` reads this stamp.
    wr "$polledf" "$(date +%s)"
    # A held job result (over the job cap) is tried again soon.
    if [ -s "$jendedf" ] || [ -s "$wendedf" ]; then nap 5 || exit 0; else nap 15 || exit 0; fi
    continue
  fi
  TOKEN=$(sh "$here/mind-checkin" token "$ORIGIN" 2>/dev/null) || TOKEN=
  case $TOKEN in ''|*[!A-Za-z0-9_.-]*) fail || exit 0; continue ;; esac
  started=$(date +%s)
  # With notices held, never wait past the moment they are due (at least 2 s, so a poll is never mistaken for a spin).
  _pw=$POLL_WAIT
  _nw=$(notice_wait)
  # (A value of 0 means due but not allowed to post, a cap: keep the normal wait rather than polling every 2 s.)
  if [ -n "$_nw" ] && [ "$_nw" -gt 0 ] && [ "$_nw" -lt "$_pw" ]; then _pw=$_nw; [ "$_pw" -ge 2 ] || _pw=2; fi
  # BT23: the ids marked waiting are only those of a session that is idle (and never while paused).
  PJOBS=$JOBPOLL; PPR=$JOBPR; PWAIT=
  if [ -z "$paused" ] && session_idle; then PWAIT=$JOBPOLL; fi
  PWATCH=$WATCHPOLL
  # The stamp `mind-checkin status --here` reads is written as the poll starts too: a poll in flight is a relay that is listening.
  wr "$polledf" "$(date +%s)"
  get_poll "$_pw" "$tasks"
  PJOBS=; PPR=; PWAIT=; PWATCH=
  if [ "$CODE" != 200 ]; then fail || exit 0; continue; fi
  bo=0
  wr "$polledf" "$(date +%s)"
  parse_body
  # Paused on an untested Claude Code: the poll above told the server so; nothing is posted or acked.
  if [ -n "$paused" ]; then
    [ $(($(date +%s) - started)) -ge 2 ] || nap 5 || exit 0
    continue
  fi
  take_jobs
  take_watches
  jobs_flush
  take_notices
  split_new
  if [ ! -s "$T/new" ] && [ ! -s "$T/ackonly" ] && [ ! -s "$T/noticeack" ]; then
    # A poll that came back at once with nothing is not a long poll: do not spin (a poll that brought a job result did its work).
    post_due_notices || { [ -n "$JPROG$WPROG" ] || [ $(($(date +%s) - started)) -ge 2 ] || nap 5 || exit 0; }
    continue
  fi
  if [ -s "$T/new" ]; then
    # Messages that arrive within the next few seconds go in the same turn.
    nap "$COALESCE" || exit 0
    cp "$T/msgs" "$T/msgs1"
    get_poll 0 "$tasks"
    if [ "$CODE" = 200 ]; then parse_body; take_notices; else cp "$T/msgs1" "$T/msgs"; fi
    split_new
    build_text
    if [ -n "$IDS" ]; then
      if ! post_line "$TEXT"; then fail || exit 0; continue; fi
      remember "$IDS $NIDS"
      [ -z "$NIDS" ] || forget_pending "$NIDS"
      [ -z "$WIDS" ] || { job_posted; watch_done; }
    fi
  fi
  # No message went out: the held notices may be due now (an urgent one arrived, or they are old enough).
  noticed=
  if [ -z "$IDS" ] && post_due_notices; then noticed=1; fi
  ack_ids=$(cat "$T/ackonly" | tr '\n' ' ')
  ack_ids="$ack_ids${IDS:-} $(tr '\n' ' ' < "$T/noticeack")"
  [ -n "$(printf '%s' "$ack_ids" | tr -d ' ')" ] || continue
  posted=$IDS$noticed
  IDS=
  post_ack "$ack_ids"
  if [ "$CODE" != 200 ]; then fail || exit 0; continue; fi
  # A round that only re-acked (nothing new was posted) must not become a tight loop if the server keeps handing the same
  # messages back (an ack it could not store): a poll that came back at once waits, as an empty one does.
  if [ -z "$posted" ]; then [ $(($(date +%s) - started)) -ge 2 ] || nap 5 || exit 0; fi
done
